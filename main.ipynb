   "source": [
    "# ============================================\n",
    "\n",
    "# ARTIFACT SAVE / LOAD HELPERS\n",
    "\n",
    "# ============================================\n",
    "\n",
    "import pickle\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "def save_artifacts(model, tokenizer, label_encoder, save_dir: Path = MODEL_SAVE_DIR):\n",
    "    \"\"\"\n",
    "    Save model, tokenizer, and label encoder for Flask deployment.\n",
    "    \"\"\"\n",
    "    save_dir.mkdir(parents=True, exist_ok=True)\n",
    "    model_path = save_dir / \"glove_gru.keras\"\n",
    "    tokenizer_path = save_dir / \"tokenizer.pkl\"\n",
    "    encoder_path = save_dir / \"label_encoder.pkl\"\n",
    "\n",
    "    model.save(model_path)\n",
    "    with open(tokenizer_path, \"wb\") as f:\n",
    "        pickle.dump(tokenizer, f)\n",
    "    with open(encoder_path, \"wb\") as f:\n",
    "        pickle.dump(label_encoder, f)\n",
    "\n",
    "    print(\"\\nArtifacts saved:\")\n",
    "    for p in [model_path, tokenizer_path, encoder_path]:\n",
    "        print(f\"  {p}  ({p.stat().st_size:,} bytes)\")\n",
    "\n",
    "\n",
    "def verify_artifacts(save_dir: Path = MODEL_SAVE_DIR):\n",
    "    \"\"\"\n",
    "    Reload and print key metadata to confirm everything is consistent.\n",
    "    \"\"\"\n",
    "    from tensorflow.keras.models import load_model\n",
    "\n",
    "    model = load_model(str(save_dir / \"glove_gru.keras\"))\n",
    "    with open(save_dir / \"tokenizer.pkl\", \"rb\") as f:\n",
    "        tk = pickle.load(f)\n",
    "    with open(save_dir / \"label_encoder.pkl\", \"rb\") as f:\n",
    "        le = pickle.load(f)\n",
    "\n",
    "    print(\"\\n Verification \")\n",
    "    print(f\"  Model input shape : {model.input_shape}\")\n",
    "    print(f\"  Tokenizer vocab   : {tk.num_words}\")\n",
    "    print(f\"  Label encoder     : {list(le.classes_)}\")\n",
    "    print(f\"  Max sequence len  : {MAX_SEQUENCE_LENGTH}\")\n",
    "\n",
    "\n",
    "# Uncomment after training glove_gru to save:\n",
    "# save_artifacts(glove_gru, tokenizer, le)\n",
    "# verify_artifacts()"
   ]
