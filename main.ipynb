   "source": [
    "## Deployment Constants & Preprocessing Pipeline\n",
    "\n",
    "Define reusable preprocessing and artifact-saving utilities here so training, testing, and Flask inference all use the **exact same** steps."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MAX_SEQUENCE_LENGTH = 100\n",
      "EMBEDDING_DIM = 100\n",
      "Artifacts will be saved to: Mental_Health_Flask\\model\n"
     ]
    }
   ],
   "source": [
    "# ============================================\n",
    "\n",
    "# CONFIGURATION (must match training & Flask)\n",
    "\n",
    "# ============================================\n",
    "from pathlib import Path\n",
    "MAX_SEQUENCE_LENGTH = 100\n",
    "EMBEDDING_DIM = 100\n",
    "MODEL_SAVE_DIR = Path(\"Mental_Health_Flask/model\")\n",
    "\n",
    "print(f\"MAX_SEQUENCE_LENGTH = {MAX_SEQUENCE_LENGTH}\")\n",
    "print(f\"EMBEDDING_DIM = {EMBEDDING_DIM}\")\n",
    "print(f\"Artifacts will be saved to: {MODEL_SAVE_DIR}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Raw:      I haven't been feeling well... kinda sad & anxious!! Check https://example.com\n",
      "Cleaned:  n't feel well kinda sad anxious check\n"
     ]
    }
   ],
   "source": [
    "# ============================================\n",
    "\n",
    "# PREPROCESSING FUNCTION (identical to cells above)\n",
    "\n",
    "# Flask app.py will import/replicate this exactly.\n",
    "\n",
    "# ============================================\n",
    "\n",
    "import re\n",
    "import nltk\n",
    "from nltk.tokenize import word_tokenize\n",
    "from nltk.corpus import stopwords\n",
    "from nltk.stem import WordNetLemmatizer\n",
    "\n",
    "# Ensure NLTK resources exist\n",
    "nltk.download(\"punkt\", quiet=True)\n",
    "nltk.download(\"punkt_tab\", quiet=True)\n",
    "nltk.download(\"stopwords\", quiet=True)\n",
    "nltk.download(\"wordnet\", quiet=True)\n",
    "\n",
    "stop_words = set(stopwords.words(\"english\"))\n",
    "keep_words = {\n",
    "    \"not\", \"no\", \"nor\", \"never\",\n",
    "\n",
    "    \"don\\'t\", \"didn\\'t\", \"doesn\\'t\",\n",
    "\n",
    "    \"can\\'t\", \"won\\'t\", \"isn\\'t\",\n",
    "\n",
    "    \"aren\\'t\", \"wasn\\'t\", \"weren\\'t\",\n",
    "\n",
    "    \"couldn\\'t\", \"shouldn\\'t\", \"wouldn\\'t\",\n",
    "\n",
    "    \"haven\\'t\", \"hasn\\'t\", \"hadn\\'t\"\n",
    "\n",
    "}\n",
    "custom_stopwords = stop_words - keep_words\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "\n",
    "\n",
    "def preprocess_text(text: str) -> str:\n",
    "    \"\"\"\n",
    "    Apply the exact same cleaning steps used on the training corpus.\n",
    "    Returns a space-joined string ready for the Keras tokenizer.\n",
    "    \"\"\"\n",
    "    text = str(text).lower()\n",
    "    text = re.sub(r'http\\S+|www\\S+|https\\S+', '', text)\n",
    "    text = re.sub(r'<.*?>', '', text)\n",
    "    text = re.sub(r'[^\\w\\s\\']', '', text)\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    tokens = word_tokenize(text)\n",
    "    tokens = [w for w in tokens if w.lower() not in custom_stopwords]\n",
    "    tokens = [lemmatizer.lemmatize(w, pos='v') for w in tokens]\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "\n",
    "# Quick sanity check\n",
    "sample = \"I haven't been feeling well... kinda sad & anxious!! Check https://example.com\"\n",
    "print(\"Raw:     \", sample)\n",
    "print(\"Cleaned: \", preprocess_text(sample))"
   ]
  },
