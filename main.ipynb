    "# ============================================\n",
    "\n",
    "# DEMO: preprocess a raw string the way Flask will\n",
    "\n",
    "# ============================================\n",
    "from tensorflow.keras.preprocessing.text import Tokenizer\n",
    "from tensorflow.keras.preprocessing.sequence import pad_sequences",
    "\n",
    "tokenizer = Tokenizer(num_words=10000, oov_token=\"<OOV>\")\n",
    "raw_input = \"I haven't been feeling well... kinda sad & anxious!! Check https://example.com\"\n",
    "cleaned = preprocess_text(raw_input)\n",
    "demo_seq = tokenizer.texts_to_sequences([cleaned])\n",
    "demo_pad = pad_sequences(demo_seq, maxlen=MAX_SEQUENCE_LENGTH, padding=\"post\", truncating=\"post\")\n",
    "print(f\"Raw input : {raw_input}\")\n",
    "print(f\"Cleaned   : {cleaned}\")\n",
    "print(f\"Padded seq : {demo_pad[0][:20]}...  (shape={demo_pad.shape})\")"
   ]
